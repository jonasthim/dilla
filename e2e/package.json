{
  "name": "@dilla/e2e",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "test": "node --test web/support/peer-seed.test.ts",
    "test:e2e": "playwright test --config playwright.config.ts --project=chromium",
    "test:e2e:matrix": "playwright test --config playwright.config.ts --project=chromium --project=firefox --project=webkit --project=firefox-persistent",
    "test:e2e:media": "playwright test --config playwright.media.config.ts --project=chromium-media --project=firefox-media",
    "test:e2e:spike": "playwright test --config playwright.media.config.ts --project=spike-chromium --project=spike-firefox",
    "test:e2e:core": "playwright test --config playwright.core.config.ts --project=chromium-core --project=firefox-core",
    "test:e2e:web": "playwright test --config playwright.web.config.ts --project=chromium-web --project=firefox-web --project=webkit-web",
    "test:e2e:core:chromium": "playwright test --config playwright.core.config.ts --project=chromium-core",
    "test:e2e:core:firefox": "playwright test --config playwright.core.config.ts --project=firefox-core",
    "test:e2e:web:chromium": "playwright test --config playwright.web.config.ts --project=chromium-web",
    "test:e2e:web:firefox": "playwright test --config playwright.web.config.ts --project=firefox-web",
    "test:e2e:web:webkit": "playwright test --config playwright.web.config.ts --project=webkit-web",
    "test:e2e:voice:chromium": "playwright test --config playwright.voice.config.ts --project=chromium-voice",
    "test:e2e:voice:firefox": "playwright test --config playwright.voice.config.ts --project=firefox-voice",
    "test:e2e:music": "playwright test --config playwright.music.config.ts --project=chromium-music",
    "test:e2e:music:firefox": "playwright test --config playwright.music.config.ts --project=firefox-music",
    "demo:web": "playwright test --config playwright.demo.config.ts",
    "docs:shots": "node scripts/shoot-docs.mjs",
    "ux:world": "node ux/world.mjs",
    "ux:shots": "node ux/shots.mjs",
    "ux:sheets": "node ux/sheets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "axe-core": "4.13.0"
  }
}

# Invariant 1: a group is registered with its dilla_binding, once per group id (409
# E_GROUP_EXISTS). A text group is refused for a channel whose visibility is invite or discoverable,
# or whose mode is readable (403 E_MODE_READABLE); a private e2ee channel takes one, and a call
# group exists whatever the channel's text mode. The test host records the channels, because the
# channels table is Plan 2's. A registration adopts exactly one leaf, the registering device's
# own, listed in its user's signed device list: dave's user has published no list, so his
# registration of either kind is 400 E_INVALID_REQUEST (hardening G), and the same channels then
# take alice's and bob's groups, so the refusals left nothing behind. A text group whose
# external_senders names a key other than the instance's (carol's own, under the instance's
# credential, as a patched client builds it) is one the instance could never propose into, so it is
# 400 E_BINDING_INVALID (DS-MEMBERSHIP-01), and the same channel then takes alice's honest group.
instance dilla
client alice
client bob
client carol
client dave device_list=none
channel e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1 visibility=private mode=e2ee
expect_reject E_INVALID_REQUEST group unlisted kind=text target=e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1 community=none creator=dave
group listed kind=text target=e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1 community=none creator=alice
channel e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6 visibility=invite mode=readable
expect_reject E_INVALID_REQUEST group unlisted_voice kind=call target=e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6 community=none creator=dave
group listed_voice kind=call target=e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6e6 community=none creator=bob
channel f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1 visibility=private mode=e2ee
group chat kind=text target=f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1 community=none creator=alice
expect_reject E_GROUP_EXISTS group again kind=text target=f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1 community=none creator=bob
channel f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2 visibility=private mode=readable
expect_reject E_MODE_READABLE group readable kind=text target=f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2 community=none creator=alice
channel f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3 visibility=invite mode=readable
expect_reject E_MODE_READABLE group invite kind=text target=f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3 community=none creator=alice
channel f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5 visibility=discoverable mode=readable
expect_reject E_MODE_READABLE group discoverable kind=text target=f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5 community=none creator=alice
channel f6f6f6f6f6f6f6f6f6f6f6f6f6f6f6f6 visibility=invite mode=readable
group voice kind=call target=f6f6f6f6f6f6f6f6f6f6f6f6f6f6f6f6 community=none creator=bob
join carol chat via=welcome
send alice chat the private e2ee channel's group works
expect_decrypts carol chat the private e2ee channel's group works
channel f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7 visibility=private mode=e2ee
expect_reject E_BINDING_INVALID group forged kind=text target=f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7 community=none creator=carol external_sender=forged
group governed kind=text target=f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7 community=none creator=alice

+/// Release the raw Box returned by df_create. The generated DFState class
+/// destructor accepts a WasmRefCell pointer and cannot free this raw pointer.
+#[wasm_bindgen]
+pub unsafe fn df_free(st: *mut DFState) {
+    if !st.is_null() {
+        drop(Box::from_raw(st));
+    }
+}
+
+/// Clear stream history without rebuilding the compiled inference plans.
+#[wasm_bindgen]
+pub unsafe fn df_reset(st: *mut DFState) {
+    st.as_mut().expect("Invalid pointer").0.reset_stream().expect("Could not reset stream");
+}

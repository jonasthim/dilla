{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": false,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test", "harness"],
  "exclude": ["src/worker", "node_modules", "wasm"]
}

    "jsdom": "^26",
    "oxc-parser": "^0.127.0",
    "oxc-resolver": "^11.21.2",
    "playwright": "^1.50",
    "react": "^19",
    "react-docgen": "^8.0.4",
    "react-dom": "^19",
    "recast": "^0.23.21",
    "storybook": "^10.6.3",
    "tinyspy": "^4.0.6",
    "ts-dedent": "^2.3.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6",
    "use-sync-external-store": "^1.7.0",

  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./base.css": "./src/styles/base.css"
  },
  "scripts": {
    "test": "vitest run && node --test scripts/shoot-stories.test.mjs",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "node scripts/check-stories.mjs",
    "test:storybook:ci": "concurrently -k -s first -n SB,TEST \"http-server storybook-static --port 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && node scripts/check-stories.mjs http://127.0.0.1:6006\""
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },

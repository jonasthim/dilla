# SP-27: ubuntu-latest runner shape without a throwaway branch.
FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl git build-essential pkg-config xz-utils iproute2 jq \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://go.dev/dl/go1.27.0.linux-amd64.tar.gz | tar -C /usr/local -xz
RUN curl -fsSL https://nodejs.org/dist/v24.15.0/node-v24.15.0-linux-x64.tar.xz | tar -C /usr/local --strip-components=1 -xJ
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.98.1 \
      --target wasm32-unknown-unknown --target wasm32-wasip1
ENV PATH=/root/.cargo/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
RUN cargo install wasm-pack --version 0.15.0 --locked \
 && cargo install wasm-bindgen-cli --version 0.2.128 --locked
COPY --chmod=0755 <<'EOF' /usr/local/bin/sp27
#!/usr/bin/env bash
set -euo pipefail
leg="${1:?usage: sp27 suite|pairs|no-internal-ip|shell}"
rm -rf /work && mkdir /work
tar -C /src --exclude=./node_modules --exclude=./target --exclude='*/node_modules' -cf - . | tar -C /work -xf -
cd /work
echo "== ip -4 addr"; ip -4 addr
start=$(date +%s)
cargo build -p dilla-core-wasi --target wasm32-wasip1 --release --locked
mkdir -p internal/mlswasi/testdata
cp target/wasm32-wasip1/release/dilla_core_wasi.wasm internal/mlswasi/testdata/
cargo build -p dilla-testkit --release --locked
wasm-pack build core/dilla-core-wasm --target web --release --mode no-install --out-dir ../../packages/media/wasm
npm ci
npx playwright install --with-deps chromium firefox
built=$(date +%s)
echo "== setup seconds $((built - start))"
set +e
case "$leg" in
  suite) DILLA_TESTKIT=/work/target/release/dilla-testkit GOMAXPROCS=4 npm run test:e2e:media -w @dilla/e2e ;;
  pairs) GOMAXPROCS=4 npx playwright test --config e2e/playwright.media.config.ts --project=spike-chromium ci-harness-pairs.spec.ts ;;
  no-internal-ip) DILLA_MEDIA_SFU_NO_INTERNAL_IP=1 GOMAXPROCS=4 npx playwright test --config e2e/playwright.media.config.ts --project=spike-chromium ci-harness-pairs.spec.ts ;;
  shell) GOMAXPROCS=4 npx playwright test --config e2e/playwright.media.config.ts --project=spike-chromium-shell ;;
  *) echo "unknown leg $leg"; exit 2 ;;
esac
status=$?
done=$(date +%s)
echo "== test seconds $((done - built)); total seconds $((done - start))"
exit "$status"
EOF
WORKDIR /work

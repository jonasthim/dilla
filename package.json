{
  "name": "dilla-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "dilla: self-hosted, end-to-end encrypted community chat, voice and video",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "core/dilla-core-wasm/spike",
    "e2e"
  ],
  "scripts": {
    "test": "npm run check:docs && npm run check:brief && npm run check:copy && npm run check:css && npm run check:ci && npm test --workspaces --if-present && npm run lint",
    "lint": "eslint --max-warnings 0 --no-error-on-unmatched-pattern packages/client-core packages/web",
    "check:docs": "node scripts/check-protocol-docs.mjs",
    "test:docs-check": "node --test scripts/check-protocol-docs.test.mjs",
    "check:brief": "node scripts/check-design-brief.mjs",
    "test:brief-check": "node --test scripts/check-design-brief.test.mjs",
    "check:copy": "node scripts/check-ui-copy.mjs",
    "check:css": "node scripts/check-css-vars.mjs",
    "test:css-check": "node --test scripts/check-css-vars.test.mjs",
    "test:copy-check": "node --test scripts/check-ui-copy.test.mjs",
    "check:ci": "node scripts/check-ci-workflow.mjs",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "test:ci-check": "node --test scripts/check-ci-workflow.test.mjs scripts/ci-areas.test.mjs scripts/install-ci-tool.test.mjs scripts/fetch-retry.test.mjs",
    "test:manifest-writer": "node --test scripts/write-manifest.test.mjs",
    "test:wasm-size-check": "node --test scripts/check-wasm-size.test.mjs",
    "test:install": "bash deploy/install_test.sh",
    "vectors": "[ ! -d packages ] || npm run vectors --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @dilla/e2e",
    "noise:prepare": "node experiments/noise/prepare.mjs",
    "noise:test": "node --test experiments/noise/test/*.test.mjs experiments/noise/*.test.mjs",
    "noise:build": "DILLA_NOISE_MODE=evaluation npm run build -w @dilla/web",
    "noise:build:beta": "DILLA_NOISE_MODE=beta npm run build -w @dilla/web",
    "test:noise-release": "node --test scripts/release-noise-mode.test.mjs experiments/noise/build-gate.test.mjs"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript-eslint": "8.71.1"
  },
  "overrides": {
    "uuid": "11.1.1",
    "@vitest/mocker": "4.1.12",
    "axe-core": "4.13.0",
    "typescript": "5.9.3"
  }
}
